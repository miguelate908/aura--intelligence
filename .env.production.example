# Copia este archivo como .env.production y completa los valores. NUNCA lo subas a Git.
DOMAIN=tu-dominio.com

DB_NAME=aura_db
DB_USER=aura_user
DB_PASSWORD=pon_una_clave_larga_y_unica
# El servidor de base de datos se llama "db" dentro de Docker; usa la misma clave de arriba
DATABASE_URL=postgresql://aura_user:pon_una_clave_larga_y_unica@db:5432/aura_db

JWT_SECRET_KEY=genera_una_de_64_caracteres_aleatorios
ADMIN_API_KEY=genera_otra_distinta

# Opcional: asistente con modelo de lenguaje
ANTHROPIC_API_KEY=

# Opcional: aviso por correo de cada contacto nuevo (si lo dejas vacío, solo se guardan en la base)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEADS_NOTIFY_TO=
